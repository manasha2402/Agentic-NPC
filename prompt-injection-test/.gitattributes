# Keep Linux line endings for files that run inside the Docker container,
# so a Windows checkout (Git autocrlf) cannot break them.
*.sh   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
Dockerfile text eol=lf
Modelfile-* text eol=lf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
